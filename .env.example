# Buat kedua nilai dengan: cargo run -- secrets
DASHBOARD_TOKEN=
DATA_ENCRYPTION_KEY=
# Optional: self-hosted LibreTranslate enables automatic bot reply translations.
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
# Opsional: override URL database tanpa menyimpan password di TOML.
# DATABASE_URL=postgres://bot:password@localhost/whatsapp_bot?sslmode=require
# DATABASE_URL=mongodb://bot:password@localhost:27017/whatsapp_bot?authSource=admin
RUST_LOG=whatsapp_bot=info,whatsapp_rust=error,wacore=error
# pretty: timestamp + colored terminal output; json: structured server logs.
LOG_FORMAT=pretty
# NO_COLOR=1 disables ANSI; CLICOLOR_FORCE=1 enables it for redirected output.

